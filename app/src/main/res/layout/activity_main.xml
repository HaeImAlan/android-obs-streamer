<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FF000000">

    <TextureView
        android:id="@+id/textureView"
        android:layout_width="match_parent"
        android:layout_height="match_parent" />

    <!-- Focus ring indicator -->
    <View
        android:id="@+id/focusRing"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:visibility="gone" />

    <!-- Controls overlay -->
    <LinearLayout
        android:id="@+id/controlsPanel"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingTop="12dp"
        android:paddingBottom="12dp"
        android:background="#CC000000">

        <!-- Status -->
        <TextView
            android:id="@+id/statusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Waiting for permission..."
            android:textColor="#FFFFFFFF"
            android:textSize="14sp"
            android:fontFamily="monospace"
            android:gravity="center" />

        <TextView
            android:id="@+id/connectionInfo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textColor="#FF888888"
            android:textSize="11sp"
            android:fontFamily="monospace"
            android:gravity="center"
            android:layout_marginTop="2dp"
            android:visibility="gone" />

        <!-- Row 1: Res | FPS -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Res"
                android:textColor="#FF888888"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/resolutionSpinner"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#FF444444" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="FPS"
                android:textColor="#FF888888"
                android:textSize="12sp" />

            <Spinner
                android:id="@+id/fpsSpinner"
                android:layout_width="wrap_content"
                android:layout_height="36dp"
                android:layout_marginStart="4dp" />
        </LinearLayout>

        <!-- Row 2: AF mode | AE lock -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="6dp">

            <TextView
                android:id="@+id/afModeButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="AF: Continuous"
                android:textColor="#FF00CC66"
                android:textSize="12sp"
                android:background="?android:attr/selectableItemBackground" />

            <View
                android:layout_width="1dp"
                android:layout_height="20dp"
                android:layout_marginStart="12dp"
                android:layout_marginEnd="12dp"
                android:background="#FF444444" />

            <TextView
                android:id="@+id/aeLockButton"
                android:layout_width="wrap_content"
                android:layout_height="32dp"
                android:gravity="center"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:text="AE: Auto"
                android:textColor="#FF00CC66"
                android:textSize="12sp"
                android:background="?android:attr/selectableItemBackground" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Tap preview to focus"
                android:textColor="#FF555555"
                android:textSize="10sp" />
        </LinearLayout>

        <!-- Row 3: Exposure compensation slider -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="6dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="EV"
                android:textColor="#FF888888"
                android:textSize="12sp" />

            <SeekBar
                android:id="@+id/evSeekBar"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:layout_marginEnd="8dp" />

            <TextView
                android:id="@+id/evValueText"
                android:layout_width="36dp"
                android:layout_height="wrap_content"
                android:text="0"
                android:textColor="#FFFFFFFF"
                android:textSize="12sp"
                android:gravity="center" />
        </LinearLayout>

        <!-- Row 4: Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="8dp">

            <Button
                android:id="@+id/screenOffButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Screen Off"
                android:textSize="12sp"
                android:layout_marginEnd="12dp"
                android:enabled="false" />

            <Button
                android:id="@+id/toggleButton"
                android:layout_width="wrap_content"
                android:layout_height="40dp"
                android:text="Start"
                android:textSize="12sp"
                android:enabled="false" />
        </LinearLayout>

    </LinearLayout>

</FrameLayout>
